---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const wa = 'https://wa.me/573138793438';
const github = 'https://github.com/crearbots';
---

<Layout
  title="Sebastian Romero · Automatización y dashboards"
  description="Ingeniero de sistemas en Colombia. Diseño dashboards, informes y automatizaciones con Python y Node.js para equipos que necesitan operar con claridad."
>
  <header class="site-header">
    <div class="wrap nav">
      <a class="nav-brand" href={`${base}#`}>Sebastian Romero</a>
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-menu"
        id="nav-toggle"
      >
        Menú
      </button>
      <ul class="nav-links" id="nav-menu">
        <li><a href={`${base}#servicios`}>Servicios</a></li>
        <li><a href={`${base}#casos`}>Casos</a></li>
        <li><a href={`${base}#sobre-mi`}>Sobre mí</a></li>
        <li><a href={`${base}#contacto`}>Contacto</a></li>
        <li><a href={github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      </ul>
    </div>
  </header>

  <main id="contenido">
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap">
        <p class="hero-eyebrow">Disponible para proyectos</p>
        <h1 id="hero-title">Automatización y dashboards que tu equipo puede usar cada semana</h1>
        <p class="hero-sub">
          Soy Sebastian Romero, ingeniero de sistemas. Construyo herramientas web e informes
          operativos — no demos para impresionar, sistemas para trabajar.
        </p>
        <p class="hero-meta">
          <span>Colombia</span>
          <span>UTC−5</span>
          <span>Remoto</span>
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href={wa} target="_blank" rel="noopener noreferrer">
            Hablemos por WhatsApp
          </a>
          <a class="btn btn-ghost" href={`${base}#casos`}>Ver casos</a>
          <a
            class="btn btn-link"
            href={github}
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub →
          </a>
        </div>
      </div>
    </section>

    <section id="servicios" aria-labelledby="servicios-title">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Servicios</p>
          <h2 id="servicios-title">En qué puedo ayudarte</h2>
        </div>
        <div class="services-grid">
          <article class="service-card">
            <div class="service-icon" aria-hidden="true">01</div>
            <h3>Dashboards e informes operativos</h3>
            <p>
              Dejas de armar el reporte a mano. Tableros y resúmenes semanales listos para
              compartir con tu equipo.
            </p>
          </article>
          <article class="service-card">
            <div class="service-icon" aria-hidden="true">02</div>
            <h3>Automatización de procesos</h3>
            <p>
              Scripts y flujos que quitan trabajo repetitivo: Excel, mensajes, cargas de datos y
              tareas en Linux.
            </p>
          </article>
          <article class="service-card">
            <div class="service-icon" aria-hidden="true">03</div>
            <h3>Desarrollo web orientado a operación</h3>
            <p>
              Paneles internos, login, carga de archivos y vistas claras para quien no es técnico.
            </p>
          </article>
          <article class="service-card">
            <div class="service-icon" aria-hidden="true">04</div>
            <h3>Backend con Python y Node.js</h3>
            <p>
              APIs y lógica de negocio cuando tu proceso ya no cabe en una hoja de cálculo.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="casos" aria-labelledby="casos-title">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Casos</p>
          <h2 id="casos-title">Trabajo real, no demos</h2>
        </div>

        <article class="case" aria-labelledby="caso-censo">
          <div class="case-header">
            <h3 id="caso-censo">censo</h3>
            <span class="badge badge-live">Proyecto real · en uso</span>
          </div>
          <dl class="case-grid">
            <div class="case-block">
              <dt>Problema</dt>
              <dd>
                Equipo de instalaciones de una app de comunidad con registros duplicados y
                seguimiento disperso; el informe salía por WhatsApp a mano.
              </dd>
            </div>
            <div class="case-block">
              <dt>Solución</dt>
              <dd>
                Web interna con login, carga de Excel, dashboard de seguimiento e informe listo
                para compartir.
              </dd>
            </div>
            <div class="case-block">
              <dt>Resultado</dt>
              <dd>
                Dashboard de avance e informe semanal para WhatsApp en operación;
                versión usable y versionada (v1.1–v1.4) con el equipo.
              </dd>
            </div>
            <div class="case-block">
              <dt>Stack</dt>
              <dd>Python, FastAPI, SQLAlchemy, Jinja2, SQLite, Railway</dd>
            </div>
          </dl>
          <div class="case-stack" aria-label="Tecnologías">
            <span class="stack-chip">Python</span>
            <span class="stack-chip">FastAPI</span>
            <span class="stack-chip">SQLAlchemy</span>
            <span class="stack-chip">Jinja2</span>
            <span class="stack-chip">SQLite</span>
            <span class="stack-chip">Railway</span>
          </div>
          <div class="shot-gallery" aria-label="Capturas del producto censo" data-lightbox-gallery>
            <figure class="shot-frame">
              <div class="shot-chrome" aria-hidden="true">
                <div class="shot-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="shot-url">infomira-censo · /dashboard</div>
              </div>
              <div class="shot-media">
                <button
                  type="button"
                  class="shot-trigger"
                  data-lightbox-open
                  data-lightbox-src={`${base}images/censo/dashboard-avance.png`}
                  data-lightbox-alt="Dashboard InfoMIRA Censo: avance del equipo 290 de 500 (58 %) en Resultados septiembre 2026"
                  data-lightbox-caption="Dashboard de avance"
                  aria-label="Ampliar imagen: Dashboard de avance"
                >
                  <img
                    src={`${base}images/censo/dashboard-avance.png`}
                    alt="Dashboard InfoMIRA Censo: avance del equipo 290 de 500 (58 %) en Resultados septiembre 2026"
                    width="1200"
                    height="750"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <figcaption class="shot-caption">Dashboard de avance</figcaption>
            </figure>
            <figure class="shot-frame">
              <div class="shot-chrome" aria-hidden="true">
                <div class="shot-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="shot-url">infomira-censo · evolución diaria</div>
              </div>
              <div class="shot-media">
                <button
                  type="button"
                  class="shot-trigger"
                  data-lightbox-open
                  data-lightbox-src={`${base}images/censo/dashboard-evolucion.png`}
                  data-lightbox-alt="Gráfico de evolución diaria del censo InfoMIRA: acumulado de personas instaladas en el tiempo"
                  data-lightbox-caption="Evolución del censo"
                  aria-label="Ampliar imagen: Evolución del censo"
                >
                  <img
                    src={`${base}images/censo/dashboard-evolucion.png`}
                    alt="Gráfico de evolución diaria del censo InfoMIRA: acumulado de personas instaladas en el tiempo"
                    width="1200"
                    height="750"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <figcaption class="shot-caption">Evolución del censo</figcaption>
            </figure>
            <figure class="shot-frame">
              <div class="shot-chrome" aria-hidden="true">
                <div class="shot-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="shot-url">infomira-censo · /informe</div>
              </div>
              <div class="shot-media">
                <button
                  type="button"
                  class="shot-trigger"
                  data-lightbox-open
                  data-lightbox-src={`${base}images/censo/informe-whatsapp.png`}
                  data-lightbox-alt="Informe semanal de InfoMIRA Censo listo para copiar y pegar en WhatsApp"
                  data-lightbox-caption="Informe semanal para WhatsApp"
                  aria-label="Ampliar imagen: Informe semanal para WhatsApp"
                >
                  <img
                    src={`${base}images/censo/informe-whatsapp.png`}
                    alt="Informe semanal de InfoMIRA Censo listo para copiar y pegar en WhatsApp"
                    width="1200"
                    height="750"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <figcaption class="shot-caption">Informe semanal para WhatsApp</figcaption>
            </figure>
          </div>
          <div class="case-actions">
            <div class="case-product">
              <a
                class="btn btn-primary"
                href="https://infomira-censo-production.up.railway.app/dashboard"
                target="_blank"
                rel="noopener noreferrer"
              >
                Abrir app en producción
              </a>
              <p class="case-access-note">Requiere acceso (login)</p>
            </div>
            <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener noreferrer">
              ¿Necesitas un panel así para tu operación?
            </a>
          </div>
        </article>

        <article class="case" aria-labelledby="caso-whatsapp">
          <div class="case-header">
            <h3 id="caso-whatsapp">WhatsApp mensajes personalizados</h3>
            <span class="badge badge-wip">En evolución · en pruebas</span>
          </div>
          <dl class="case-grid">
            <div class="case-block">
              <dt>Qué es</dt>
              <dd>
                Prototipo de escritorio que toma contactos desde Excel y envía mensajes
                personalizados por WhatsApp Web.
              </dd>
            </div>
            <div class="case-block">
              <dt>Estado</dt>
              <dd>
                En pruebas. No es un SaaS publicado; es un flujo que se madura con quien lo
                necesita.
              </dd>
            </div>
            <div class="case-block">
              <dt>Stack</dt>
              <dd>Python, Tkinter, PyAutoGUI, pandas</dd>
            </div>
          </dl>
          <div class="case-stack" aria-label="Tecnologías">
            <span class="stack-chip">Python</span>
            <span class="stack-chip">Tkinter</span>
            <span class="stack-chip">PyAutoGUI</span>
            <span class="stack-chip">pandas</span>
          </div>
          <div class="case-actions">
            <a class="btn btn-primary" href={wa} target="_blank" rel="noopener noreferrer">
              Si te interesa este flujo, lo maduramos juntos
            </a>
            <a
              class="case-repo"
              href="https://github.com/crearbots/WhatsApp-Mensajes-Personalizados-Web"
              target="_blank"
              rel="noopener noreferrer"
            >
              Código en GitHub
            </a>
          </div>
        </article>
      </div>
    </section>

    <section id="como-trabajo" aria-labelledby="como-title">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Método</p>
          <h2 id="como-title">Cómo trabajo</h2>
        </div>
        <ol class="steps">
          <li class="step">
            <h3>Entender el proceso</h3>
            <p>
              Primero el flujo real: quién carga datos, qué se decide y qué se reporta. Sin eso,
              el software sobra.
            </p>
          </li>
          <li class="step">
            <h3>Entregar algo usable</h3>
            <p>
              Prefiero una versión que el equipo ya pueda usar a una demo perfecta que nadie
              toca.
            </p>
          </li>
          <li class="step">
            <h3>Dejarlo claro</h3>
            <p>
              Documentación breve, acceso ordenado y cambios versionados para que no dependan de
              mí en cada ajuste.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section id="sobre-mi" aria-labelledby="sobre-title">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Sobre mí</p>
          <h2 id="sobre-title">Ingeniero de sistemas, enfoque operativo</h2>
        </div>
        <div class="about-text">
          <p>
            Me importa más que tus procesos no dependan de un “héroe del Excel” que sabe dónde
            está cada hoja. Diseño herramientas para que el equipo opere con claridad: dashboards,
            informes y automatizaciones que se usan de verdad.
          </p>
          <p>
            Trabajo con Python, Node.js y Linux. Estoy en Colombia (UTC−5) y atiendo proyectos en
            remoto.
          </p>
        </div>
        <ul class="about-tags" aria-label="Herramientas y contexto">
          <li>Python</li>
          <li>Node.js</li>
          <li>Linux</li>
          <li>Colombia · UTC−5</li>
          <li>Remoto</li>
        </ul>
      </div>
    </section>

    <section id="contacto" aria-labelledby="contacto-title">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Contacto</p>
          <h2 id="contacto-title">Hablemos</h2>
        </div>
        <div class="contact-box">
          <p>
            Cuéntame qué proceso quieres ordenar o automatizar. Respondemos por WhatsApp y vemos
            si tiene sentido trabajar juntos.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href={wa} target="_blank" rel="noopener noreferrer">
              Escribir por WhatsApp
            </a>
            <a
              class="btn btn-ghost"
              href={github}
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
          </div>
          <p class="contact-note">Horario laboral · Colombia (UTC−5)</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>Sebastian Romero · Automatización y dashboards</p>
      <p>
        <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
      </p>
    </div>
  </footer>

  <div
    id="lightbox"
    class="lightbox"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="lightbox-caption"
  >
    <div class="lightbox-backdrop" data-lightbox-close tabindex="-1"></div>
    <div class="lightbox-panel">
      <button type="button" class="lightbox-close" data-lightbox-close aria-label="Cerrar imagen ampliada">
        <span aria-hidden="true">×</span>
      </button>
      <button type="button" class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="Imagen anterior">
        <span aria-hidden="true">‹</span>
      </button>
      <figure class="lightbox-figure">
        <img id="lightbox-img" class="lightbox-img" src="" alt="" />
        <figcaption id="lightbox-caption" class="lightbox-caption"></figcaption>
      </figure>
      <button type="button" class="lightbox-nav lightbox-next" data-lightbox-next aria-label="Imagen siguiente">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  </div>

  <script>
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('nav-menu');
    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const open = menu.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menu.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

    (function initLightbox() {
      const root = document.getElementById('lightbox');
      if (!root) return;

      const imgEl = document.getElementById('lightbox-img');
      const captionEl = document.getElementById('lightbox-caption');
      const closeBtn = root.querySelector('.lightbox-close');
      const prevBtn = root.querySelector('[data-lightbox-prev]');
      const nextBtn = root.querySelector('[data-lightbox-next]');
      const triggers = Array.from(document.querySelectorAll('[data-lightbox-open]'));
      if (!imgEl || !captionEl || !closeBtn || triggers.length === 0) return;

      const focusables = () =>
        [closeBtn, prevBtn, nextBtn].filter(
          (el) => el && !el.hasAttribute('disabled') && el.offsetParent !== null
        );

      let index = 0;
      let lastFocus = null;

      function items() {
        return triggers.map((btn) => ({
          src: btn.getAttribute('data-lightbox-src') || '',
          alt: btn.getAttribute('data-lightbox-alt') || '',
          caption: btn.getAttribute('data-lightbox-caption') || '',
        }));
      }

      function show(i) {
        const list = items();
        if (!list.length) return;
        index = ((i % list.length) + list.length) % list.length;
        const item = list[index];
        imgEl.src = item.src;
        imgEl.alt = item.alt;
        captionEl.textContent = item.caption;
      }

      function openAt(i, trigger) {
        lastFocus = trigger || document.activeElement;
        show(i);
        root.hidden = false;
        document.body.classList.add('lightbox-open');
        closeBtn.focus();
      }

      function close() {
        if (root.hidden) return;
        root.hidden = true;
        document.body.classList.remove('lightbox-open');
        imgEl.removeAttribute('src');
        imgEl.alt = '';
        captionEl.textContent = '';
        if (lastFocus && typeof lastFocus.focus === 'function') {
          lastFocus.focus();
        }
        lastFocus = null;
      }

      function step(delta) {
        show(index + delta);
      }

      triggers.forEach((btn, i) => {
        btn.addEventListener('click', () => openAt(i, btn));
      });

      root.querySelectorAll('[data-lightbox-close]').forEach((el) => {
        el.addEventListener('click', close);
      });
      if (prevBtn) prevBtn.addEventListener('click', () => step(-1));
      if (nextBtn) nextBtn.addEventListener('click', () => step(1));

      document.addEventListener('keydown', (e) => {
        if (root.hidden) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          close();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          step(-1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          step(1);
        } else if (e.key === 'Tab') {
          const list = focusables();
          if (list.length === 0) return;
          const first = list[0];
          const last = list[list.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    })();
  </script>
</Layout>
