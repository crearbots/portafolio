---
import Layout from '../layouts/Layout.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const base = import.meta.env.BASE_URL;
const wa = 'https://wa.me/573138793438';
const linkedin = 'https://www.linkedin.com/in/juan-sebastian-romero-velez-321b67429/';
const aboutPhotoRel = 'images/about/sebastian.jpg';
const aboutPhotoExists = existsSync(join(process.cwd(), 'public', aboutPhotoRel));
---

<Layout
  title="Sebastian Romero · Automatización y dashboards"
  description="Ingeniero de sistemas en Colombia. Diseño dashboards, informes y automatizaciones con Python y Node.js para equipos que necesitan operar con claridad."
>
  <header class="site-header">
    <div class="wrap nav">
      <a class="nav-brand" href={`${base}#`}>Sebastian Romero</a>
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-menu"
        id="nav-toggle"
      >
        Menú
      </button>
      <ul class="nav-links" id="nav-menu">
        <li><a href={`${base}#servicios`}>Servicios</a></li>
        <li><a href={`${base}#casos`}>Casos</a></li>
        <li><a href={`${base}#opiniones`}>Opiniones</a></li>
        <li><a href={`${base}#sobre-mi`}>Sobre mí</a></li>
        <li><a href={`${base}#contacto`}>Contacto</a></li>
      </ul>
    </div>
  </header>
  <button
    type="button"
    class="nav-backdrop"
    id="nav-backdrop"
    tabindex="-1"
    aria-hidden="true"
    aria-label="Cerrar menú"
  ></button>

  <main id="contenido">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-fx" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="hero-eyebrow">Disponible para proyectos</p>
          <h1 id="hero-title"><span class="hero-title-gradient">Automatización y dashboards que tu equipo puede usar cada semana</span></h1>
          <p class="hero-sub">
            Soy Sebastian Romero, ingeniero de sistemas. Construyo herramientas web e informes
            operativos — no demos para impresionar, sistemas para trabajar.
          </p>
          <p class="hero-meta">
            <span>Colombia</span>
            <span>UTC−5</span>
            <span>Remoto</span>
          </p>
          <div class="cta-row">
            <a class="btn btn-primary" href={wa} target="_blank" rel="noopener noreferrer">
              Hablemos por WhatsApp
            </a>
            <a class="btn btn-ghost" href={`${base}#casos`}>Ver casos</a>
            <a
              class="btn btn-link"
              href={linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn →
            </a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-visual-glow" aria-hidden="true"></div>
          <div class="hero-stage">
            <figure class="hero-product">
              <div class="hero-product-chrome" aria-hidden="true">
                <div class="shot-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="shot-url">dashboard · evolución</div>
              </div>
              <div class="hero-product-media">
                <img
                  src={`${base}images/sintonia/hero-dashboard.png?v=oct16`}
                  alt="Gráfico de evolución diaria de Sintonía"
                  width="1232"
                  height="619"
                  decoding="async"
                  fetchpriority="high"
                />
              </div>
              <figcaption class="hero-product-caption">
                <a href={`${base}#casos`}>Sintonía · evolución del dashboard</a>
              </figcaption>
            </figure>
            <div class="hero-float hero-float--stack" aria-hidden="true">
              <span>Python</span>
              <span>FastAPI</span>
            </div>
            <svg class="hero-orbit" viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="160" cy="160" r="118" stroke="url(#orbitGrad)" stroke-width="1.2" stroke-dasharray="4 8" opacity="0.55" />
              <circle cx="160" cy="160" r="148" stroke="rgba(232,160,84,0.22)" stroke-width="1" stroke-dasharray="2 10" />
              <defs>
                <linearGradient id="orbitGrad" x1="40" y1="40" x2="280" y2="280">
                  <stop stop-color="#6ba8d8" />
                  <stop offset="1" stop-color="#e8a054" />
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <section id="servicios" aria-labelledby="servicios-title">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Servicios</p>
          <h2 id="servicios-title">En qué puedo ayudarte</h2>
        </div>
        <div class="services-grid">
          <article class="service-card">
            <div class="service-icon" aria-hidden="true">01</div>
            <h3>Dashboards e informes operativos</h3>
            <p>
              Dejas de armar el reporte a mano. Tableros y resúmenes semanales listos para
              compartir con tu equipo.
            </p>
          </article>
          <article class="service-card">
            <div class="service-icon" aria-hidden="true">02</div>
            <h3>Automatización de procesos</h3>
            <p>
              Scripts y flujos que quitan trabajo repetitivo: Excel, mensajes, cargas de datos y
              tareas en Linux.
            </p>
          </article>
          <article class="service-card">
            <div class="service-icon" aria-hidden="true">03</div>
            <h3>Desarrollo web orientado a operación</h3>
            <p>
              Paneles internos, login, carga de archivos y vistas claras para quien no es técnico.
            </p>
          </article>
          <article class="service-card">
            <div class="service-icon" aria-hidden="true">04</div>
            <h3>Backend con Python y Node.js</h3>
            <p>
              APIs y lógica de negocio cuando tu proceso ya no cabe en una hoja de cálculo.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="casos" aria-labelledby="casos-title">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Casos</p>
          <h2 id="casos-title">Trabajo real, no demos</h2>
        </div>

        <article class="case case--magazine" aria-labelledby="caso-censo">
          <div class="case-header">
            <h3 id="caso-censo" class="case-title-lockup">
              <img
                src={`${base}images/sintonia/sintonia-lockup-merged-dark.svg`}
                alt="Sintonía"
                width="358"
                height="78"
                class="case-title-lockup-img"
              />
            </h3>
            <span class="badge badge-live">Proyecto real · en uso</span>
          </div>
          <dl class="case-grid">
            <div class="case-block">
              <dt>Problema</dt>
              <dd>
                Equipo de instalaciones de una app de comunidad con registros duplicados y
                seguimiento disperso; el informe salía por WhatsApp a mano.
              </dd>
            </div>
            <div class="case-block">
              <dt>Solución</dt>
              <dd>
                Web interna con login, carga de Excel, dashboard de seguimiento e informe listo
                para compartir.
              </dd>
            </div>
            <div class="case-block">
              <dt>Resultado</dt>
              <dd>
                Dashboard de avance e informe semanal para WhatsApp en operación;
                versión usable y versionada (v1.1 → v1.13, en uso y en evolución continua) con el equipo.
              </dd>
            </div>
            <div class="case-block">
              <dt>Stack</dt>
              <dd>Python, FastAPI, SQLAlchemy, Jinja2, SQLite, Railway</dd>
            </div>
          </dl>
          <div class="case-stack" aria-label="Tecnologías">
            <span class="stack-chip">Python</span>
            <span class="stack-chip">FastAPI</span>
            <span class="stack-chip">SQLAlchemy</span>
            <span class="stack-chip">Jinja2</span>
            <span class="stack-chip">SQLite</span>
            <span class="stack-chip">Railway</span>
          </div>
          <div class="shot-gallery shot-gallery--editorial" aria-label="Capturas del producto Sintonía" data-lightbox-gallery>
            <figure class="shot-frame shot-frame--feature">
              <div class="shot-chrome" aria-hidden="true">
                <div class="shot-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="shot-url">Sintonía · evolución diaria</div>
              </div>
              <div class="shot-media">
                <button
                  type="button"
                  class="shot-trigger"
                  data-lightbox-open
                  data-lightbox-src={`${base}images/sintonia/dashboard-evolucion.png?v=oct16`}
                  data-lightbox-alt="Gráfico en modo oscuro: crecimiento de Sintonía, registro interno vs sede nacional, de agosto a octubre de 2026"
                  data-lightbox-caption="Crecimiento · registro interno vs sede nacional"
                  aria-label="Ampliar imagen: Crecimiento · registro interno vs sede nacional"
                >
                  <img
                    src={`${base}images/sintonia/dashboard-evolucion.png?v=oct16`}
                    alt="Gráfico en modo oscuro: crecimiento de Sintonía, registro interno vs sede nacional, de agosto a octubre de 2026"
                    width="1232"
                    height="619"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <figcaption class="shot-caption">Crecimiento · registro interno vs sede nacional</figcaption>
            </figure>
            <figure class="shot-frame">
              <div class="shot-chrome" aria-hidden="true">
                <div class="shot-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="shot-url">Sintonía · /dashboard</div>
              </div>
              <div class="shot-media">
                <button
                  type="button"
                  class="shot-trigger"
                  data-lightbox-open
                  data-lightbox-src={`${base}images/sintonia/dashboard-avance.png?v=oct16`}
                  data-lightbox-alt="Dashboard de resultados de Sintonía: 333 de 975 instalaciones en Resultados · Octubre 2026"
                  data-lightbox-caption="Dashboard de avance"
                  aria-label="Ampliar imagen: Dashboard de avance"
                >
                  <img
                    src={`${base}images/sintonia/dashboard-avance.png?v=oct16`}
                    alt="Dashboard de resultados de Sintonía: 333 de 975 instalaciones en Resultados · Octubre 2026"
                    width="1305"
                    height="753"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <figcaption class="shot-caption">Dashboard de avance</figcaption>
            </figure>
            <figure class="shot-frame">
              <div class="shot-chrome" aria-hidden="true">
                <div class="shot-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="shot-url">Sintonía · /programacion</div>
              </div>
              <div class="shot-media">
                <button
                  type="button"
                  class="shot-trigger"
                  data-lightbox-open
                  data-lightbox-src={`${base}images/sintonia/programacion-semana.png?v=oct16`}
                  data-lightbox-alt="Tarjeta de programación semanal de Sintonía lista para compartir en WhatsApp"
                  data-lightbox-caption="Programación semanal para WhatsApp"
                  aria-label="Ampliar imagen: Programación semanal para WhatsApp"
                >
                  <img
                    src={`${base}images/sintonia/programacion-semana.png?v=oct16`}
                    alt="Tarjeta de programación semanal de Sintonía lista para compartir en WhatsApp"
                    width="1305"
                    height="811"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <figcaption class="shot-caption">Programación semanal para WhatsApp</figcaption>
            </figure>
          </div>
          <div class="case-actions">
            <div class="case-product">
              <a
                class="btn btn-primary"
                href="https://sintonia-app.up.railway.app"
                target="_blank"
                rel="noopener noreferrer"
              >
                Abrir app en producción
              </a>
              <p class="case-access-note">Requiere acceso (login)</p>
            </div>
            <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener noreferrer">
              ¿Necesitas un panel así para tu operación?
            </a>
          </div>
        </article>

        <article class="case case--magazine" aria-labelledby="caso-summa">
          <div class="case-header">
            <h3 id="caso-summa" class="case-title-lockup">
              <img
                src={`${base}images/summa/summa-lockup-dark.svg`}
                alt="Summa"
                width="269"
                height="78"
                class="case-title-lockup-img"
              />
            </h3>
            <span class="badge badge-live">Proyecto real · entregado</span>
          </div>
          <p class="case-subtitle">Procesador Excel contable para facturación electrónica</p>
          <dl class="case-grid">
            <div class="case-block">
              <dt>Cliente</dt>
              <dd>Asociación de contadores</dd>
            </div>
            <div class="case-block">
              <dt>Qué hace</dt>
              <dd>
                Toma un Excel de facturación electrónica y genera otro con seis hojas listas para
                análisis: Original, RECIBIDOS, EMITIDOS, RADIAN, RETEFUENTE y RETEICA. Incluye panel
                de totales (compras, ventas y diferencia) y una interfaz de escritorio para Windows.
              </dd>
            </div>
            <div class="case-block">
              <dt>Alcance MVP</dt>
              <dd>
                App de escritorio (Python), generación de las 6 hojas, resumen de totales, protección
                por contraseña en la primera ejecución por computador. Sin demo pública ni descarga.
              </dd>
            </div>
            <div class="case-block">
              <dt>Stack</dt>
              <dd>Python · Excel · Windows</dd>
            </div>
          </dl>
          <div class="case-stack" aria-label="Tecnologías">
            <span class="stack-chip">Python</span>
            <span class="stack-chip">Excel</span>
            <span class="stack-chip">Windows</span>
          </div>
          <div class="shot-gallery shot-gallery--contain" aria-label="Capturas del producto Summa" data-lightbox-gallery>
            <figure class="shot-frame">
              <div class="shot-chrome" aria-hidden="true">
                <div class="shot-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="shot-url">Summa · escritorio</div>
              </div>
              <div class="shot-media">
                <button
                  type="button"
                  class="shot-trigger"
                  data-lightbox-open
                  data-lightbox-src={`${base}images/summa/01-ui-vacia.png`}
                  data-lightbox-alt="Interfaz de escritorio de Summa lista para cargar un Excel de facturación electrónica"
                  data-lightbox-caption="Interfaz de escritorio"
                  aria-label="Ampliar imagen: Interfaz de escritorio"
                >
                  <img
                    src={`${base}images/summa/01-ui-vacia.png`}
                    alt="Interfaz de escritorio de Summa lista para cargar un Excel de facturación electrónica"
                    width="852"
                    height="813"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <figcaption class="shot-caption">Interfaz de escritorio</figcaption>
            </figure>
            <figure class="shot-frame">
              <div class="shot-chrome" aria-hidden="true">
                <div class="shot-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="shot-url">Summa · totales</div>
              </div>
              <div class="shot-media">
                <button
                  type="button"
                  class="shot-trigger"
                  data-lightbox-open
                  data-lightbox-src={`${base}images/summa/02-ui-procesada-limpia.png`}
                  data-lightbox-alt="Summa tras procesar un archivo: panel de totales de compras, ventas y diferencia"
                  data-lightbox-caption="Panel de totales"
                  aria-label="Ampliar imagen: Panel de totales"
                >
                  <img
                    src={`${base}images/summa/02-ui-procesada-limpia.png`}
                    alt="Summa tras procesar un archivo: panel de totales de compras, ventas y diferencia"
                    width="852"
                    height="811"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <figcaption class="shot-caption">Panel de totales</figcaption>
            </figure>
            <figure class="shot-frame">
              <div class="shot-chrome" aria-hidden="true">
                <div class="shot-dots">
                  <span></span><span></span><span></span>
                </div>
                <div class="shot-url">Summa · hoja RADIAN</div>
              </div>
              <div class="shot-media">
                <button
                  type="button"
                  class="shot-trigger"
                  data-lightbox-open
                  data-lightbox-src={`${base}images/summa/03-excel-radian.png`}
                  data-lightbox-alt="Excel generado por Summa mostrando la hoja RADIAN"
                  data-lightbox-caption="Excel generado · hoja RADIAN"
                  aria-label="Ampliar imagen: Excel generado · hoja RADIAN"
                >
                  <img
                    src={`${base}images/summa/03-excel-radian.png`}
                    alt="Excel generado por Summa mostrando la hoja RADIAN"
                    width="1080"
                    height="763"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
              <figcaption class="shot-caption">Excel generado · hoja RADIAN</figcaption>
            </figure>
          </div>
          <div class="case-actions">
            <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener noreferrer">
              ¿Necesitas automatizar un proceso en Excel?
            </a>
          </div>
        </article>
      </div>
    </section>

    <section id="opiniones" aria-labelledby="opiniones-title">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Opiniones</p>
          <h2 id="opiniones-title">Lo que dicen quienes ya trabajaron conmigo</h2>
        </div>
        <div class="opinions-grid">
          <div class="opinions-intro">
            <p>
              Si usaste Sintonía, Summa u otro trabajo conmigo, me ayuda mucho saber cómo te fue.
            </p>
            <ul class="testimonials" aria-live="polite">
              <li class="testimonial-empty">
                Pronto verás aquí opiniones de clientes. Si ya trabajamos juntos, deja la tuya.
              </li>
            </ul>
          </div>
          <form
            class="contact-box opinion-form"
            action="https://formsubmit.co/jsrvjuan@gmail.com"
            method="POST"
          >
            <input type="hidden" name="_cc" value="crearbots+opiniones@mail.grokbot.com" />
            <input type="hidden" name="_subject" value="Nueva opinión · portafolio CrearBots" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" value="https://crearbots.github.io/portafolio/?enviado=1#opiniones" />
            <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <p id="opinion-ok" class="form-success" role="status" hidden>
              ¡Gracias! Recibí tu opinión. La revisaré antes de publicarla.
            </p>
            <div class="form-row">
              <div class="field">
                <label for="op-nombre">Nombre</label>
                <input id="op-nombre" name="nombre" type="text" required autocomplete="name" />
              </div>
              <div class="field">
                <label for="op-cargo">Cargo o empresa <span class="optional">(opcional)</span></label>
                <input id="op-cargo" name="cargo" type="text" autocomplete="organization" />
              </div>
            </div>
            <div class="form-row">
              <div class="field">
                <label for="op-email">Correo</label>
                <input id="op-email" name="email" type="email" required autocomplete="email" aria-describedby="op-email-hint" />
              </div>
              <div class="field">
                <label for="op-producto">Producto</label>
                <select id="op-producto" name="producto" required>
                  <option value="" disabled selected>Selecciona…</option>
                  <option value="Sintonía">Sintonía</option>
                  <option value="Summa">Summa</option>
                  <option value="Otro">Otro</option>
                </select>
              </div>
              <p class="field-hint form-row-hint" id="op-email-hint">Solo para verificar tu opinión; no se publica.</p>
            </div>
            <div class="field" id="op-producto-otro-field" hidden>
              <label for="op-producto-otro">Nombre del producto</label>
              <input id="op-producto-otro" name="producto_otro" type="text" disabled />
            </div>
            <div class="field">
              <label for="op-opinion">Opinión</label>
              <textarea id="op-opinion" name="opinion" rows="5" required></textarea>
            </div>
            <label class="check">
              <input type="checkbox" name="autorizo" value="si" required />
              <span>Autorizo publicar mi nombre y opinión en el portafolio</span>
            </label>
            <button type="submit" class="btn btn-primary">Enviar opinión</button>
          </form>
        </div>
      </div>
      <script is:inline>
        if (new URLSearchParams(location.search).get('enviado') === '1') {
          var ok = document.getElementById('opinion-ok');
          if (ok) ok.hidden = false;
        }
      </script>
    </section>
  <script is:inline>
    document.querySelectorAll('#opiniones form [required]').forEach(function (el) {
      var msg = el.type === 'checkbox' ? 'Marca esta casilla si quieres continuar.' : 'Por favor completa este campo.';
      el.addEventListener('invalid', function () { if (el.validity.valueMissing) el.setCustomValidity(msg); else if (el.validity.typeMismatch) el.setCustomValidity('Ingresa un correo electrónico válido.'); });
      ['input', 'change'].forEach(function (ev) { el.addEventListener(ev, function () { el.setCustomValidity(''); }); });
    });
    (function () {
      var sel = document.getElementById('op-producto');
      var wrap = document.getElementById('op-producto-otro-field');
      var inp = document.getElementById('op-producto-otro');
      if (!sel || !wrap || !inp) return;
      inp.addEventListener('invalid', function () { if (inp.validity.valueMissing) inp.setCustomValidity('Escribe el nombre del producto.'); });
      inp.addEventListener('input', function () { inp.setCustomValidity(''); });
      function sync() {
        var otro = sel.value === 'Otro';
        wrap.hidden = !otro;
        inp.disabled = !otro;
        inp.required = otro;
        if (!otro) inp.value = '';
        inp.setCustomValidity('');
      }
      sel.addEventListener('change', sync);
      sync();
    })();
  </script>


    <section id="como-trabajo" aria-labelledby="como-title">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Método</p>
          <h2 id="como-title">Cómo trabajo</h2>
        </div>
        <ol class="steps">
          <li class="step">
            <h3>Entender el proceso</h3>
            <p>
              Primero el flujo real: quién carga datos, qué se decide y qué se reporta. Sin eso,
              el software sobra.
            </p>
          </li>
          <li class="step">
            <h3>Entregar algo usable</h3>
            <p>
              Prefiero una versión que el equipo ya pueda usar a una demo perfecta que nadie
              toca.
            </p>
          </li>
          <li class="step">
            <h3>Dejarlo claro</h3>
            <p>
              Documentación breve, acceso ordenado y cambios versionados para que no dependan de
              mí en cada ajuste.
            </p>
          </li>
        </ol>
      </div>
    </section>

    <section id="sobre-mi" aria-labelledby="sobre-title">
      <div class="wrap">
        <div class="section-head">
          <p class="section-label">Sobre mí</p>
          <h2 id="sobre-title">Ingeniero de sistemas, enfoque operativo</h2>
        </div>
        <div class="about-layout">
